{
  "name": "@biashara-mall/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve,dev --parallel=9",
    "dev:services": "nx run-many -t serve -p api-gateway user-service product-service seller-service order-service admin-service --parallel=6",
    "dev:user-ui": "nx dev user-ui",
    "dev:seller-ui": "nx dev seller-ui",
    "dev:admin-ui": "nx dev admin-ui",
    "dev:gateway": "nx serve api-gateway",
    "build": "nx run-many -t build",
    "prisma:generate": "prisma generate --schema packages/prisma/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema packages/prisma/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema packages/prisma/prisma/schema.prisma"
  },
  "private": true,
  "dependencies": {
    "express": "^5.1.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prisma/client": "6.19.3",
    "@biashara-mall/prisma": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/express": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "react-refresh": "^0.10.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1",
    "prisma": "6.19.3",
    "@types/cors": "^2.8.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
