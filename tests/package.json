{
  "name": "@biashara-mall/tests",
  "version": "0.0.0",
  "private": true,
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^default"
        ],
        "options": {
          "command": "./run-tests.sh",
          "cwd": "tests"
        }
      }
    }
  },
  "dependencies": {
    "@biashara-mall/config": "workspace:*",
    "@biashara-mall/error-handler": "workspace:*",
    "@biashara-mall/prisma": "workspace:*",
    "express": "^5.1.0"
  }
}
