# Copy to .env and fill in. Values shown are local-dev defaults or placeholders.
# NOTE: services read .env at boot only — restart `bun run dev` after edits.

# --- Database (docker-compose mongodb; replica set required by Prisma) ---
DATABASE_URL=mongodb://localhost:27017/biashara_mall?replicaSet=rs0

# --- Redis (docker-compose redis; optional — packages/redis defaults to this) ---
REDIS_URL=redis://localhost:6379

# --- Kafka (docker-compose redpanda locally; Confluent Cloud in production) ---
# KAFKA_BROKERS=localhost:9092
# Production only — presence of both switches the client to SSL+SASL:
# KAFKA_API_KEY=
# KAFKA_API_SECRET=

# --- Clerk (dashboard.clerk.com -> API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk Dashboard -> Webhooks -> endpoint -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# --- ImageKit (imagekit.io -> Developer options) ---
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_id>

# --- Payments (Phase 4; packages/payments factory selects on PAYMENT_PROVIDER) ---
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Gateway service targets (defaults are the local dev ports) ---
# USER_SERVICE_URL=http://localhost:6001
# PRODUCT_SERVICE_URL=http://localhost:6002
# SELLER_SERVICE_URL=http://localhost:6003
# ORDER_SERVICE_URL=http://localhost:6004
# ADMIN_SERVICE_URL=http://localhost:6005
# CHATTING_SERVICE_URL=http://localhost:6006
# RECOMMENDATION_SERVICE_URL=http://localhost:6007

# --- UI origins allowed by the gateway's CORS ---
# USER_UI_URL=http://localhost:3000
# SELLER_UI_URL=http://localhost:3001
# ADMIN_UI_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Per-app apps/*-ui/.env.local (Next.js reads those, not this file):
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
#   CLERK_SECRET_KEY=sk_test_...
#   NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080
# ---------------------------------------------------------------------------
