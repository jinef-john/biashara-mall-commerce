{
  "name": "@biashara-mall/seller-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/seller-service/dist/package.json",
          "{workspaceRoot}/apps/seller-service/dist/bun.lock"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/seller-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@biashara-mall/seller-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@biashara-mall/seller-service:build:development"
          },
          "production": {
            "buildTarget": "@biashara-mall/seller-service:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "express": "^5.1.0",
    "@clerk/express": "^2.1.57",
    "@biashara-mall/auth": "workspace:*",
    "@biashara-mall/error-handler": "workspace:*",
    "@biashara-mall/prisma": "workspace:*",
    "dotenv": "^17.4.2"
  }
}
